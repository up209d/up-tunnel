UPTUNNEL_SERVER=wss://tunnel.example.com/control
UPTUNNEL_TOKEN=your-device-token-here

# ---- keepalive ----
# Seconds between pings to the server; 0 turns our own ping off and leaves
# liveness to the server's. Raise it on a metered link, lower it behind a NAT
# that reaps idle mappings quickly.
# UPTUNNEL_PING_INTERVAL=20
# Seconds a ping may go unanswered before the socket is torn down and
# reconnected; 0 pings without ever giving up on the answer.
# UPTUNNEL_PING_TIMEOUT=20

# ---- health log ----
# Connection lifecycle, separate from stdout. On by default at ./health.log in
# the directory the agent runs from; set it empty to turn it off.
# UPTUNNEL_HEALTH_LOG=health.log
# Ceiling; a trim keeps the newest 80%, so no logrotate is needed.
# UPTUNNEL_HEALTH_LOG_MAX_LINES=1000
