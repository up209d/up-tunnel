# ---- secrets: never commit these ----
# Server config. `npm run dev` loads server/.env via node --env-file.
.env
.env.*
!.env.example
# The systemd unit's EnvironmentFile, if a copy is ever staged in-tree.
uptunnel.env

# Agent bearer secrets. tokens.example.json is the committed template.
tokens.json
tokens.*.json
!tokens.example.json

# Client config — holds this device's token.
up.yaml
up.yml
up.json
!up.example.yaml

# TLS material and keys of any kind.
*.pem
*.key
*.crt
*.csr
*.p12
*.pfx
id_rsa
id_ed25519

# ---- node ----
node_modules/
dist/
*.tsbuildinfo
npm-debug.log*

# ---- python ----
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- runtime logs ----
# Both the server (HEALTH_LOG_FILE) and the agents (UPTUNNEL_HEALTH_LOG) default
# to ./health.log, so any run started in-tree drops one next to its own source.
# The .tmp is the trim's write-then-rename staging file; *.log does not cover it.
*.log
*.log.tmp
health.log
uptunnel-health.log

# ---- editors / os / local tooling ----
.DS_Store
.idea/
.vscode/
.claude/settings.local.json
