# Copy to .env and adjust. Every value here is the built-in default unless noted.

# ---- control plane (agents connect here, via nginx) ----
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8081
CONTROL_PATH=/control

# ---- public HTTP data plane (nginx proxies *.HTTP_DOMAIN here) ----
HTTP_HOST=127.0.0.1
HTTP_PORT=8080
# Base domain for HTTP tunnels: foo.tun.example.com -> the "foo" tunnel.
HTTP_DOMAIN=tun.example.com
# Scheme used when telling agents their public URL.
PUBLIC_SCHEME=https

# ---- public TCP data plane (these ports are exposed directly, no nginx) ----
TCP_BIND_HOST=0.0.0.0
TCP_PORT_MIN=20000
TCP_PORT_MAX=20099
# Hostname users dial for TCP tunnels; defaults to HTTP_DOMAIN.
PUBLIC_TCP_HOST=tunnel.example.com

# ---- auth ----
# Either a JSON file with per-token subdomain/port grants...
TOKENS_FILE=./tokens.json
# ...or a quick inline list: name:secret,name2:secret2
# AUTH_TOKENS=laptop:change-me-to-32-random-chars

# ---- operator API (localhost only by default) ----
ADMIN_HOST=127.0.0.1
ADMIN_PORT=8082
# Leave empty to skip auth; only safe while bound to localhost.
ADMIN_TOKEN=

# ---- tuning ----
# Per-stream, per-direction credit window in bytes.
STREAM_WINDOW=262144
# Pause all of an agent's streams once its socket has this many bytes queued.
WS_MAX_BUFFERED=8388608
HEARTBEAT_MS=30000
MAX_HTTP_HEAD_BYTES=32768

LOG_LEVEL=info
# LOG_FORMAT=json
